{
  "scene": "first-altar",
  "title": "Digital Divination",
  "eyebrow": "The Altar",
  "inscription": {
    "line1": "All things pass into shadow.",
    "line2": "What remains is what was true."
  },
  "cta": {
    "text": "Draw Your Cards",
    "href": "draw.html"
  },
  "palette": {
    "void":        "#060610",
    "deep":        "#0c0c1e",
    "surface":     "#181838",
    "border":      "#2a2a4a",
    "border-gold": "rgba(212,168,64,0.2)",
    "gold":        "#d4a840",
    "gold-light":  "#f0d878",
    "gold-dark":   "#8a6518",
    "gold-dim":    "#4a3510",
    "text":        "#f0ead8",
    "text-mid":    "#d0c0a0",
    "text-dim":    "#988870",
    "bone":        "#d4c9a8",
    "ash":         "#7a7060",
    "tallow":      "#f0d878",
    "umber":       "#3d2b1f"
  },
  "animations": {
    "flicker": {
      "keyframes": [
        { "pct": 0,   "transform": "scaleX(1) rotate(-1deg)",    "opacity": "1" },
        { "pct": 33,  "transform": "scaleX(0.85) rotate(2deg)",  "opacity": "0.85" },
        { "pct": 66,  "transform": "scaleX(1.1) rotate(-2deg)",  "opacity": "1" },
        { "pct": 100, "transform": "scaleX(0.95) rotate(1deg)",  "opacity": "0.9" }
      ],
      "duration": "1.8s",
      "easing": "ease-in-out",
      "iteration": "infinite",
      "direction": "alternate"
    },
    "rise": {
      "keyframes": [
        { "pct": 0,   "transform": "translateY(0) translateX(0) scale(1)",      "opacity": "0.35" },
        { "pct": 50,  "transform": "translateY(-28px) translateX(5px) scale(2)","opacity": "0.12" },
        { "pct": 100, "transform": "translateY(-60px) translateX(-4px) scale(3)","opacity": "0" }
      ],
      "duration": "3.2s",
      "easing": "ease-out",
      "iteration": "infinite"
    },
    "drain": {
      "keyframes": [
        { "pct": 0,   "height": "65%" },
        { "pct": 100, "height": "4%" }
      ],
      "duration": "8s",
      "easing": "linear",
      "iteration": "infinite"
    },
    "fill": {
      "keyframes": [
        { "pct": 0,   "height": "4%" },
        { "pct": 100, "height": "65%" }
      ],
      "duration": "8s",
      "easing": "linear",
      "iteration": "infinite"
    },
    "drip": {
      "keyframes": [
        { "pct": 0,   "opacity": "1", "transform": "translateX(-50%) translateY(0)" },
        { "pct": 100, "opacity": "0", "transform": "translateX(-50%) translateY(10px)" }
      ],
      "duration": "0.45s",
      "easing": "linear",
      "iteration": "infinite"
    },
    "glow-pulse": {
      "keyframes": [
        { "pct": 0,   "opacity": "0.35", "transform": "scale(0.9)" },
        { "pct": 100, "opacity": "0.7",  "transform": "scale(1.25)" }
      ],
      "duration": "1.8s",
      "easing": "ease-in-out",
      "iteration": "infinite",
      "direction": "alternate"
    },
    "float": {
      "keyframes": [
        { "pct": 0,   "transform": "translateY(0)" },
        { "pct": 50,  "transform": "translateY(-6px)" },
        { "pct": 100, "transform": "translateY(0)" }
      ],
      "duration": "5s",
      "easing": "ease-in-out",
      "iteration": "infinite"
    }
  },
  "objects": [
    {
      "id": "atmosphere",
      "name": "Atmosphere",
      "role": "atmosphere",
      "order": 0,
      "layers": [
        {
          "id": "sigil-left",
          "chars": "☽",
          "style": { "color": "text-dim", "font-size": "1.1rem", "opacity": "0.3" }
        },
        {
          "id": "stars",
          "chars": "✦  ✧  ✦  ✧  ✦",
          "style": { "color": "gold-dark", "font-size": "0.45rem", "opacity": "0.4", "letter-spacing": "0.5em" }
        },
        {
          "id": "sigil-right",
          "chars": "☾",
          "style": { "color": "text-dim", "font-size": "1.1rem", "opacity": "0.3" }
        }
      ]
    },
    {
      "id": "candle-left",
