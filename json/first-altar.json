      "role": "object",
      "order": 1,
      "position": "left",
      "layers": [
        {
          "id": "smoke",
          "chars": "░",
          "style": { "color": "text-dim", "font-size": "0.65rem", "opacity": "0.25" },
          "animate": "rise"
        },
        {
          "id": "glow",
          "chars": "◉",
          "style": { "color": "gold", "font-size": "3rem", "opacity": "0.08" },
          "animate": "glow-pulse"
        },
        {
          "id": "flame",
          "chars": "🜂",
          "style": { "color": "gold-light", "font-size": "1.2rem", "filter": "drop-shadow(0 0 8px rgba(212,168,64,0.6))" },
          "animate": "flicker"
        },
        {
          "id": "wick",
          "chars": "╎",
          "style": { "color": "text-dim", "font-size": "0.5rem" }
        },
        {
          "id": "body",
          "chars": "▐█▌\n▐█▌\n▐█▌\n▐█▌",
          "style": { "color": "bone", "font-size": "0.95rem", "line-height": "1.1" }
        },
        {
          "id": "wax",
          "chars": "▗▄▖",
          "style": { "color": "text-mid", "font-size": "0.55rem", "opacity": "0.65" }
        },
        {
          "id": "base",
