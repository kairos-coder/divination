{
  "scene": "first-altar",
  "title": "Digital Divination · The Altar",
  "inscription": {
    "line1": "All things pass into shadow.",
    "line2": "What remains is what was true."
  },
  "cta": {
    "text": "Draw Your Cards",
    "href": "#"
  },
  "palette": {
    "void":  "#0a0806",
    "bone":  "#d4c9a8",
    "tallow":"#e8d87a",
    "umber": "#3d2b1f",
    "ash":   "#7a7060",
    "gold":  "#c9a84c",
    "smoke": "#1a1410"
  },
  "animations": {
    "flicker": {
      "keyframes": [
        { "pct": 0,   "transform": "scaleX(1) rotate(-1deg)",   "opacity": 1 },
        { "pct": 33,  "transform": "scaleX(0.85) rotate(2deg)", "opacity": 0.85 },
        { "pct": 66,  "transform": "scaleX(1.1) rotate(-2deg)", "opacity": 1 },
        { "pct": 100, "transform": "scaleX(0.95) rotate(1deg)", "opacity": 0.9 }
      ],
      "duration": "1.8s",
      "easing": "ease-in-out",
      "iteration": "infinite",
      "direction": "alternate"
    },
    "rise": {
      "keyframes": [
        { "pct": 0,   "transform": "translateY(0) translateX(0) scale(1)",    "opacity": 0.4 },
        { "pct": 50,  "transform": "translateY(-30px) translateX(6px) scale(2)", "opacity": 0.15 },
        { "pct": 100, "transform": "translateY(-70px) translateX(-4px) scale(3)","opacity": 0 }
      ],
      "duration": "3s",
      "easing": "ease-out",
      "iteration": "infinite"
    },
    "drain": {
      "keyframes": [
        { "pct": 0,   "height": "65%" },
        { "pct": 100, "height": "5%" }
      ],
      "duration": "8s",
      "easing": "linear",
      "iteration": "infinite"
    },
    "fill": {
      "keyframes": [
        { "pct": 0,   "height": "5%" },
        { "pct": 100, "height": "65%" }
      ],
      "duration": "8s",
      "easing": "linear",
      "iteration": "infinite"
    },
    "drip": {
      "keyframes": [
        { "pct": 0,   "opacity": 1, "transform": "translateX(-50%) translateY(0)" },
        { "pct": 100, "opacity": 0, "transform": "translateX(-50%) translateY(10px)" }
      ],
      "duration": "0.4s",
      "easing": "linear",
      "iteration": "infinite"
    },
    "glow": {
      "keyframes": [
        { "pct": 0,   "opacity": 0.5, "transform": "translateX(-50%) scale(0.9)" },
        { "pct": 100, "opacity": 1,   "transform": "translateX(-50%) scale(1.3)" }
      ],
      "duration": "1.8s",
      "easing": "ease-in-out",
      "iteration": "infinite",
      "direction": "alternate"
    }
  },
